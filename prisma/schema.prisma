generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Collection {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  roomType       String   @map("room_type")
  tagline        String
  heroImage      String   @map("hero_image")
  story          String
  designerNotes  String   @map("designer_notes")
  estimatedPrice Int      @map("estimated_price")
  currency       String   @default("USD")
  dimensions     Json
  materials      String[]
  colorPalette   Json     @map("color_palette")
  gallery        String[]
  videoUrl       String?  @map("video_url")
  tourUrl        String?  @map("tour_url")

  products       Product[]

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("collections")
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  sku              String   @unique
  name             String
  category         String
  shortDescription String   @map("short_description")
  description      String
  price            Int
  currency         String   @default("USD")
  dimensions       Json
  materials        String[]
  images           String[]
  thumbnail        String
  specifications   Json
  isBestseller     Boolean  @default(false) @map("is_bestseller")
  isNew            Boolean  @default(false) @map("is_new")

  collectionId     String?  @map("collection_id")
  collection       Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  finishes         Finish[]
  colors           Color[]
  orderItems       OrderItem[]
  reviews          Review[]

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model Finish {
  id              String  @id @default(cuid())
  name            String
  hex             String
  priceAdjustment Int     @default(0) @map("price_adjustment")
  productId       String  @map("product_id")
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now()) @map("created_at")

  @@map("finishes")
}

model Color {
  id              String  @id @default(cuid())
  name            String
  hex             String
  priceAdjustment Int     @default(0) @map("price_adjustment")
  productId       String  @map("product_id")
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now()) @map("created_at")

  @@map("colors")
}

model Order {
  id          String   @id @default(cuid())
  status      String   @default("pending")
  total       Int
  currency    String   @default("USD")

  userId      String?  @map("user_id")
  userEmail   String?  @map("user_email")
  shippingAddress Json? @map("shipping_address")

  items       OrderItem[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Int
  finish    String?
  color     String?

  orderId   String  @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("order_items")
}

model Booking {
  id        String   @id @default(cuid())
  type      String
  name      String
  email     String
  phone     String?
  date      String
  time      String
  notes     String?
  status    String   @default("pending")

  userId    String?  @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("bookings")
}

model Review {
  id        String @id @default(cuid())
  rating    Int
  text      String

  productId String @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId    String @map("user_id")
  userName  String @map("user_name")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("reviews")
}
